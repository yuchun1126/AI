import numpy as np
import matplotlib.pyplot as plt

# ==========================================
# 1. 定義目標函數及其一階導函數
# ==========================================

# 定義目標函數：y = x^2
def func(x): 
    return np.square(x)

# 定義目標函數的一階導數（梯度）：dy/dx = 2*x
def dfunc(x): 
    return 2 * x

# ==========================================
# 2. 定義梯度下降法 (Gradient Descent) 核心函數
# ==========================================
def GD(x_start, df, epochs, lr):    
    """
    梯度下降法。給定起始點與目標函數的一階導函數，求在 epochs 次反覆運算中 x 的更新值
    
    :param x_start: x 的起始點    
    :param df: 目標函數的一階導函數    
    :param epochs: 反覆運算週期（迭代次數）    
    :param lr: 學習率 (learning rate)，控制每次更新的步長    
    :return: x 在每次反覆運算後的位置（包括起始點），長度為 epochs + 1    
    """
    # 建立一個陣列來儲存每一次迭代後的 x 位置，長度為 epochs + 1（包含初始位置）
    xs = np.zeros(epochs + 1)    
    x = x_start    
    xs[0] = x  # 記錄起始位置
    
    # 進行指定次數的梯度下降疊代
    for i in range(epochs):         
        dx = df(x)        
        # v 表示 x 要改變的幅度（負梯度方向乘以學習率）
        v = -dx * lr        
        x += v        
        # 記錄更新後的 x 位置
        xs[i + 1] = x    
    
    return xs

# ==========================================
# 3. 設定超參數並執行梯度下降法
# ==========================================

# 起始權重（從 x = 5 開始搜尋最小值）
x_start = 5    

# 執行週期數（迭代 15 次）
epochs = 15 

# 學習率（設定為 0.3，決定每次下降步伐的大小）
lr = 0.3   

# 執行梯度下降法，取得每次迭代的 x 座標紀錄
x = GD(x_start, dfunc, epochs, lr=lr) 

# 印出每次迭代後 x 的位置結果
print(x)
# 輸出預期範例：
# [5.00000000e+00 2.00000000e+00 8.00000000e-01 3.20000000e-01 ...]

# ==========================================
# 4. 繪製圖形視覺化呈現
# ==========================================

color = 'r'    # 設定繪圖顏色為紅色 (red)
from numpy import arange

# 產生繪製目標函數曲線的 x 軸點陣列（範圍從 -6.0 到 6.0，間距 0.01）
t = arange(-6.0, 6.0, 0.01)

# 繪製目標函數 y = x^2 的藍色基準曲線
plt.plot(t, func(t), c='b')

# 繪製梯度下降過程中 x 點移動的軌跡曲線
plt.plot(x, func(x), c=color, label='lr={}'.format(lr))    

# 在圖形上標出每次迭代時具體的點位置（散佈圖）
plt.scatter(x, func(x), c=color)    

# 顯示圖例
plt.legend()

# 顯示繪製好的視覺化圖表
plt.show()
