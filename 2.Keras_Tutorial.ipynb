import numpy as np
from tensorflow import keras
from keras.models import Sequential
from keras.layers import Dense

# ==========================================
# 1. 準備訓練資料 (Data Preparation)
# ==========================================
# 隨機產生 1000 筆樣本資料，每筆資料包含 10 個特徵值（浮點數）
data = np.random.random((1000, 10)) 

# 隨機產生 1000 筆對應的類別標籤，數值為 0 或 1（代表二元分類的兩類）
labels = np.random.randint(2, size=(1000, 1)) 

# 檢查資料與標籤的形狀（Shape）與內容
print("資料形狀：", np.shape(data))
print("第一筆資料：", data[0])
print("標籤形狀：", np.shape(labels))
print("第一筆標籤：", labels[0])


# ==========================================
# 2. 建立類神經網路模型架構 (Model Architecture)
# ==========================================
model = Sequential()  # 建立一個循序模型（層與層之間依序串接）

# 加入隱藏層：32個神經元，使用 ReLU 激活函數，並指定輸入特徵維度為 10
model.add(Dense(32, activation='relu', input_dim=10))

# 加入輸出層：1個神經元，使用 Sigmoid 激活函數（將輸出壓在 0~1 之間的機率值，適合二元分類）
model.add(Dense(1, activation='sigmoid'))


# ==========================================
# 3. 編譯模型 (Model Compilation)
# ==========================================
# 設定優化器（optimizer）、損失函數（loss）以及評估指標（metrics）
model.compile(optimizer='rmsprop', 
              loss='binary_crossentropy', 
              metrics=['accuracy'])


# ==========================================
# 4. 訓練模型 (Model Training)
# ==========================================
# 將資料餵給模型進行訓練：epochs=10 代表完整訓練 10 次，batch_size=32 代表每次更新權重前處理 32 筆資料
model.fit(data, labels, epochs=10, batch_size=32)


# ==========================================
# 5. 評估模型 (Model Evaluation)
# ==========================================
# 使用資料評估模型表現，evaluate 會回傳 [loss, accuracy]
score = model.evaluate(data, labels)

# 印出最終的準確率 (Accuracy)
print("模型最終準確率：", score[1])
